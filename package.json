{
  "name": "holon-md",
  "version": "0.1.2",
  "description": "Compile a folder of small Markdown files into the documents people read.",
  "keywords": [
    "markdown",
    "documentation",
    "docs-as-code",
    "readme",
    "include",
    "transclusion",
    "single-source",
    "compiler",
    "cli"
  ],
  "license": "MIT",
  "author": "Lukas Brückner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasB97/holon.git"
  },
  "homepage": "https://github.com/LukasB97/holon#readme",
  "bugs": "https://github.com/LukasB97/holon/issues",
  "type": "module",
  "bin": {
    "holon": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "tsc",
    "test": "node --test test/holon.test.ts",
    "docs": "node src/cli.ts docs .",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
